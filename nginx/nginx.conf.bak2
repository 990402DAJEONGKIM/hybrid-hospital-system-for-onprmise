events {}
http {
    limit_req_zone $binary_remote_addr zone=api_limit:10m  rate=30r/m;
    limit_req_zone $binary_remote_addr zone=sync_limit:10m rate=10r/m;
    limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=10r/m;

    upstream deident_api {
        server 127.0.0.1:8000;
    }
    upstream his_api {
        server 127.0.0.1:8001;
    }

    server {
        listen 80;
        server_name _;
        return 301 https://$host$request_uri;
    }

    server {
        listen 443 ssl;
        server_name _;

        ssl_certificate     /etc/nginx/certs/server.crt;
        ssl_certificate_key /etc/nginx/certs/server.key;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers on;

        access_log /var/log/nginx/access.log;
        error_log  /var/log/nginx/error.log warn;

        location /internal/ {
            allow 172.30.0.0/16;
            allow 127.0.0.1;
            deny  all;
            proxy_pass http://his_api;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        location /auth/ {
            limit_req zone=auth_limit burst=5 nodelay;
            limit_req_status 429;
            proxy_pass http://his_api;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_cookie_domain 127.0.0.1 $host;
        }

        location /portal/ {
            allow 172.30.0.0/16;
            allow 10.0.0.0/16;
            allow 127.0.0.1;
            deny  all;
            limit_req zone=api_limit burst=20 nodelay;
            limit_req_status 429;
            proxy_pass http://his_api;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        location /admin/ {
            allow 172.30.0.0/16;
            allow 10.0.0.0/16;
            allow 127.0.0.1;
            deny  all;
            limit_req zone=api_limit burst=20 nodelay;
            limit_req_status 429;
            proxy_pass http://his_api;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        location /sync/ {
            limit_req zone=sync_limit burst=5 nodelay;
            limit_req_status 429;
            proxy_pass http://deident_api;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        location = /health {
            proxy_pass http://deident_api;
            proxy_set_header Host $host;
        }

        location = /his/health {
            proxy_pass http://his_api/health;
            proxy_set_header Host $host;
        }

        location / {
            limit_req zone=api_limit burst=10 nodelay;
            limit_req_status 429;
            proxy_pass http://deident_api;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }
    }
}
